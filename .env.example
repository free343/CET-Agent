DATABASE_URL=sqlite:///data/cet_agent.db
STUDY_LEVEL=CET4
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
ADVANCED_LLM_PROVIDER=
ADVANCED_LLM_MODEL=
ADVANCED_LLM_BASE_URL=
ADVANCED_LLM_API_KEY=
# To enable the official DeepSeek advanced channel, use:
# ADVANCED_LLM_PROVIDER=openai-compatible
# ADVANCED_LLM_MODEL=deepseek-v4-flash
# ADVANCED_LLM_BASE_URL=https://api.deepseek.com
# The app then reuses DEEPSEEK_API_KEY below when ADVANCED_LLM_API_KEY is blank.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
CONFUSION_THRESHOLD=0.65
CONFUSION_WINDOW_DAYS=30
COERROR_WINDOW_HOURS=24
MAX_CONFUSION_CANDIDATES=100
SEMANTIC_WEIGHT=0.30
SPELLING_WEIGHT=0.25
COERROR_WEIGHT=0.30
TEMPORAL_WEIGHT=0.15
REMINDER_START_TIME=08:00
REMINDER_END_TIME=23:00
REMINDER_COOLDOWN_MINUTES=30

# Shared DeepSeek credential for optional interactive use and offline generation.
# Keep the real key only in the ignored local .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
